# Makefile.parallel
# Set the name of the source code file and the executable
CC = mpif90
EXTRA_LIBS = 		# -lm
SRC = hellompi.f90
CFLAGS = -o
OUTPUT = hellompiF

OBJ =

# A command to compile a parallel program with MPI
hellompi:
	$(CC) $(EXTRA_LIBS) $(SRC) $(CFLAGS) $(OUTPUT) $(OBJ)

# Delete the executable file
clean:
	rm -f $(OBJ)
